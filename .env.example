# =============================================================================
# STOWE CONTRACTING — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# SITE — Required at initialization
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://stowecontracting.com
NEXT_PUBLIC_SITE_NAME="Stowe Contracting"
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_CITY=
NEXT_PUBLIC_STATE=
NEXT_PUBLIC_ZIP=

# -----------------------------------------------------------------------------
# FORMS / EMAIL — Configure at M7 (Contact Page)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
FORM_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# CRM — SOLYNX / GoHighLevel / LeadConnector (M7)
#
# CRM_SUBMISSION_ENABLED — explicit activation gate. Must remain false until
#                          endpoints, privacy language, and routing are verified.
# CRM_PROVIDER        — identifier for logging only (e.g. 'ghl'). Not a secret.
# GHL_WEBHOOK_URL     — fallback webhook for both estimate + contact leads.
#                       Use the specific URLs below when available.
# GHL_ESTIMATE_WEBHOOK_URL — estimate-specific LeadConnector webhook URL.
# GHL_CONTACT_WEBHOOK_URL  — contact/general-inquiry LeadConnector webhook URL.
#
# Configuration states:
#   disabled      — CRM_SUBMISSION_ENABLED is not true → no external request
#   configured    — activation true + both valid HTTPS webhook URLs set
#   misconfigured — partial config → no external request, warning logged
#
# Required before live GHL activation:
#   - Verified GHL sub-account webhook URLs from SOLYNX
#   - Privacy policy updated to disclose CRM data processing
#   - GHL pipeline stages confirmed (residential / commercial / general)
#   - End-to-end test lead verified in GHL sandbox (do NOT use production yet)
# -----------------------------------------------------------------------------
CRM_PROVIDER=
CRM_SUBMISSION_ENABLED=false
GHL_WEBHOOK_URL=
GHL_ESTIMATE_WEBHOOK_URL=
GHL_CONTACT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# ANALYTICS — Configure at M8 (SEO / Analytics milestone)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# -----------------------------------------------------------------------------
# AI CHAT — Reserved for SOLYNX AI Chat Widget
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AICHAT_WIDGET_ID=

# -----------------------------------------------------------------------------
# AI PHONE — Reserved for SOLYNX AI Phone integration
# -----------------------------------------------------------------------------
AI_PHONE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# APPOINTMENT SCHEDULING — Reserved for SOLYNX scheduling integration
# -----------------------------------------------------------------------------
SCHEDULING_API_KEY=
SCHEDULING_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# REVIEW SYSTEM — Reserved for SOLYNX review platform
# -----------------------------------------------------------------------------
REVIEW_PLATFORM_API_KEY=

# -----------------------------------------------------------------------------
# MARKETING AUTOMATION — Reserved for SOLYNX marketing automation
# -----------------------------------------------------------------------------
MARKETING_AUTOMATION_KEY=

# -----------------------------------------------------------------------------
# MISSED CALL TEXT BACK / SMS — Reserved (requires A2P 10DLC compliance)
# -----------------------------------------------------------------------------
SMS_PROVIDER_API_KEY=
SMS_FROM_NUMBER=
